<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The panel is rendered empty on purpose: its content is only ever fetched over RPC,
         so the cart HTML never travels inside a (possibly cached) page. -->
    <template id="cart_offcanvas" inherit_id="website.layout" name="Cart Offcanvas">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <aside
                t-if="website.add_to_cart_action == 'open_offcanvas'"
                id="o_wsale_cart_offcanvas"
                class="offcanvas offcanvas-end"
                tabindex="-1"
                aria-labelledby="o_wsale_cart_offcanvas_title"
            >
                <div class="offcanvas-header border-bottom">
                    <h5 id="o_wsale_cart_offcanvas_title" class="offcanvas-title">My Cart</h5>
                    <button
                        type="button"
                        class="btn-close text-reset"
                        data-bs-dismiss="offcanvas"
                        aria-label="Close"
                    />
                </div>
                <!-- Filled in by the cart_offcanvas interaction. -->
                <div class="offcanvas-body">
                    <div class="text-center py-5">
                        <i class="fa fa-circle-o-notch fa-spin fa-2x text-muted"/>
                    </div>
                </div>
            </aside>
        </xpath>
    </template>

    <template id="cart_offcanvas_content" name="Cart Offcanvas Content">
        <div
            t-if="not website_sale_order or not website_sale_order.website_order_line"
            class="o_wsale_cart_offcanvas_empty text-center"
        >
            <div class="mt-5 mb-3"><t t-call="website_sale.empty_cart_svg"/></div>
            <h5 class="mb-3">Your cart is empty!</h5>
            <a href="/shop" class="btn btn-primary">Shop</a>
        </div>
        <div t-else="" class="o_wsale_cart_offcanvas_content d-flex flex-column h-100">
            <div class="o_wsale_cart_offcanvas_lines flex-grow-1 overflow-auto">
                <t t-foreach="website_sale_order.website_order_line" t-as="line">
                    <t t-set="is_combo" t-value="line.product_type == 'combo'"/>
                    <div
                        class="o_cart_product d-flex gap-3 pb-3 mb-3 border-bottom"
                        t-attf-data-product-id="#{line.product_id and line.product_id.id}"
                    >
                        <div class="o_cart_product_image">
                            <!-- Unsellable lines can have unpublished products, whose image URL
                                 portal users cannot access: fall back to the raw image data. -->
                            <t t-call="website_sale.cart_line_product_link">
                                <img
                                    t-if="not line._is_sellable() and line.product_id.image_128"
                                    t-att-src="image_data_uri(line.product_id.image_128)"
                                    class="img border rounded"
                                    t-att-alt="line.name_short"
                                />
                                <div
                                    t-else=""
                                    t-field="line.product_id.image_128"
                                    t-options="{
                                        'widget': 'image',
                                        'qweb_img_responsive': False,
                                        'class': 'border rounded',
                                    }"
                                />
                            </t>
                        </div>
                        <div class="d-flex flex-column flex-grow-1 min-w-0">
                            <t t-call="website_sale.cart_line_product_link">
                                <h6 t-out="line._get_line_header()" class="text-wrap mb-1"/>
                            </t>
                            <t t-set="combination_name" t-value="line._get_combination_name()"/>
                            <span
                                t-if="combination_name"
                                class="h6 text-muted mb-1"
                                t-out="combination_name"
                            />
                            <t t-call="website_sale.cart_line_description_following_lines"/>
                            <ul t-if="is_combo" class="list-group mb-1">
                                <t
                                    t-foreach="line.linked_line_ids.filtered('combo_item_id')"
                                    t-as="combo_item_line"
                                >
                                    <t t-call="website_sale.cart_combo_item_line"/>
                                </t>
                            </ul>
                            <div class="d-flex justify-content-between align-items-end mt-1">
                                <span class="text-muted">
                                    <t t-out="line.product_uom_qty"/>
                                    <t
                                        t-if="line.product_template_id._has_multiple_uoms()"
                                        t-out="line.product_uom_id.name"
                                    />
                                </span>
                                <t t-call="website_sale.cart_lines_price"/>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
            <div class="o_wsale_cart_offcanvas_footer border-top pt-3 mt-auto">
                <t t-call="website_sale.total">
                    <t t-set="hide_promotions" t-value="True"/>
                </t>
                <a href="/shop/cart" class="btn btn-primary w-100 mt-3">Checkout</a>
            </div>
        </div>
    </template>

</odoo>
