<?xml version="1.0"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.website_sale_cart_offcanvas</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="ecommerce_access_setting" position="after">
                <setting
                    id="cart_offcanvas_setting"
                    string="Cart Side Panel"
                    help="Show the cart in a side panel when adding a product or clicking the cart icon, instead of the standard notification.">
                    <field name="cart_offcanvas_enabled"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
