<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="website_sale_hide_all_prices.ProductRow"
       t-inherit="website_sale.ProductRow"
       t-inherit-mode="extension">
        <xpath expr="//small[@t-if='!this.props.hide_price']" position="attributes">
            <attribute name="t-if">!this.props.hide_price and !this.websiteHideAllPrices</attribute>
        </xpath>
    </t>

</templates>
