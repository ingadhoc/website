<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="website_sale_hide_all_prices.CartNotificationLine"
       t-inherit="website_sale.CartNotificationLine"
       t-inherit-mode="extension">
        <xpath expr="//div[@t-if='!line.linked_line_id']" position="attributes">
            <attribute name="t-if">!line.linked_line_id and !this.websiteHideAllPrices</attribute>
        </xpath>
    </t>

</templates>
