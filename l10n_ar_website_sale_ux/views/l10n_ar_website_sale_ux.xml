<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ar_tax_indication" name="Tax Indication- Argentina" inherit_id="website_sale.tax_indication" priority="20" active="True">
        <!-- Reemplazar el primer span (tax_excluded) para mostrar la alícuota de IVA -->
        <xpath expr="//span[contains(@t-if, 'tax_excluded')]" position="replace">
            <t t-if="website.show_line_subtotals_tax_selection == 'tax_excluded'">
                <span
                    t-if="combination_info.get('taxes') and combination_info['taxes'].name"
                    class="fs-6 fw-normal text-muted text-nowrap"
                >
                    (+ <t t-esc="combination_info['taxes'].name"/> Excluded)
                </span>
            </t>
        </xpath>

        <!-- Reemplazar el segundo span (tax_included) -->
        <xpath expr="//span[@t-else='']" position="replace">
            <span t-else="" class="fs-6 fw-normal text-muted text-nowrap">
                <t t-if="combination_info.get('taxes') and combination_info['taxes'].name">
                    (<t t-esc="combination_info['taxes'].name"/> Included)
                </t>
                <t t-else="">
                    (VAT included)
                </t>
            </span>
        </xpath>
    </template>
</odoo>
