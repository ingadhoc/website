<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_website_config_settings" model="ir.ui.view">
        <field name="name">Facebook Pixel Tracking</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="plausible_setting" position="after">
                <setting
                    id="facebook_pixel_tracking_setting"
                    string="Facebook Pixel"
                    help="Manage your Pixel integration without editing code."
                >
                    <div class="content-group">
                        <div class="row mt16">
                            <label
                                class="col-lg-4 o_light_label"
                                for="facebook_pixel_key"
                            />
                            <field
                                name="facebook_pixel_key"
                                placeholder="1234567890"
                            />
                        </div>
                        <div class="row">
                            <div class="col-lg-4" />
                            <a
                                href="https://es-la.facebook.com/business/help/952192354843755?id=1205376682832142"
                                class="oe_link fa fa-arrow-right"
                                target="_blank"
                            >
                                ¿Cómo obtengo mi código píxel?
                            </a>
                        </div>
                        <div class="row mt16">
                            <label
                                class="col-lg-4 o_light_label"
                                for="facebook_capi_access_token"
                                string="Conversions API Token"
                            />
                            <field
                                name="facebook_capi_access_token"
                                password="True"
                                placeholder="EAAG..."
                            />
                        </div>
                        <div class="row">
                            <div class="col-lg-4" />
                            <a
                                href="https://developers.facebook.com/docs/marketing-api/conversions-api/get-started#manager-events-manager-recommended"
                                class="oe_link fa fa-arrow-right"
                                target="_blank"
                            >
                                ¿Cómo genero el token de la Conversion API?
                            </a>
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
