<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website.sale.stock.hide.unavailable</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale_stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="product_availability_setting" position="after">
                <setting
                    id="out_of_stock_display_setting"
                    string="Out-of-Stock Products"
                    help="Show them, push them to the end of the shop, or hide them from the listing, search and sitemap. Set per website; the product page always stays reachable.">
                    <field name="out_of_stock_display" widget="radio"/>
                </setting>
            </setting>
        </field>
    </record>

</odoo>
