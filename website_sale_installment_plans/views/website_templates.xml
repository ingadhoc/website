<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="installment_plans" name="Installment plans">
        <ul t-if="installment_plans" class="installment-plans list-unstyled small my-1">
            <li t-foreach="installment_plans" t-as="plan">
                <i class="oi me-1" data-icon="credit_card" aria-hidden="true"/>
                <span class="fw-bold" t-out="plan['description']"/>
                <span t-if="plan['message']" class="text-muted ms-1" t-out="plan['message']"/>
            </li>
        </ul>
    </template>

    <template id="product_page_card_installment_plan" inherit_id="website_sale.product_price">
        <xpath expr="//div[@name='product_price']" position="inside">
            <div class="o_wsale_installment_plans">
                <t
                    t-call="website_sale_installment_plans.installment_plans"
                    installment_plans="product._get_installment_plans(0 if combination_info['hide_price'] else combination_info['price'])"
                />
            </div>
        </xpath>
    </template>

    <template id="product_template_products_item_installment_plan" inherit_id="website_sale.products_item">
        <xpath expr="//div[hasclass('product_price')]" position="inside">
            <t
                t-call="website_sale_installment_plans.installment_plans"
                installment_plans="product._get_installment_plans(0 if hide_price else template_price_vals['price_reduce'])"
            />
        </xpath>
    </template>
</odoo>
