msgid ""
".. |company| replace:: ADHOC SA\n"
"\n"
".. |company_logo| image:: https://raw.githubusercontent.com/ingadhoc/maintainer-tools/master/resources/adhoc-logo.png\n"
"   :alt: ADHOC SA\n"
"   :target: https://www.adhoc.com.ar\n"
