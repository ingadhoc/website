<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="products" name="website.sale.ux.products" inherit_id="website_sale.products">
        <xpath expr="//aside[@id='products_grid_before']/div" position="before">
            <a class="btn btn-primary mt-3 mb-3" href="/shop">Back to all products</a>
        </xpath>
    </template>
    <template id="products_mobile" name="website.sale.ux.products.mobile" inherit_id="website_sale.o_wsale_offcanvas">
        <xpath expr="//aside[@id='o_wsale_offcanvas']/div" position="before">
            <div style="margin:15px auto">
                <a class="btn btn-primary" href="/shop">Back to all products</a>
            </div>
        </xpath>
    </template>
</odoo>
