<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_internal_ref_products_item" inherit_id="website_sale.products_item" name="Website Products Item Internal Ref" active="False">
        <xpath expr="//div[hasclass('o_wsale_product_sub')]" position="before">
            <p t-if="product.product_variant_id.default_code" class="text-muted small">
                <span>Ref. interna: </span><span t-out='product.product_variant_id.default_code'/>
            </p>
        </xpath>
    </template>
    <!-- Core renders the name, the quotation description and the rating in this template, shared
         by the /shop tile, the wishlist and the "Products" snippet: the toggle reaches all three
         from here. Anchored on the "t-call" wrapping core's description, not on the wrapper div:
         "after" the div would nest this block inside that "t-call" and inherit its visibility. -->
    <template id="products_item_ecommerce_description" inherit_id="website_sale.product_title_and_details" name="Website Products Item eCommerce Description">
        <xpath expr="//div[hasclass('oe_subdescription_wrapper')]/parent::t" position="after">
            <t
                t-call="website_sale.product_tile_element_visibility"
                visible_element_class.f="o_wsale_products_opt_has_ecommerce_description"
            >
                <div class="o_wsale_ecommerce_description_wrapper">
                    <div class="o_wsale_ecommerce_description o_line_clamp text-muted" contenteditable="false">
                        <div t-field="product.description_ecommerce"/>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
    <!-- Core draws the ribbon on the snippet cards, but its styles are scoped under
         `.oe_website_sale`: the snippet dropped from the editor carries that class, this
         hardcoded cross-selling section does not and hangs from `#wrap`, so there the ribbon
         reaches the DOM unstyled. -->
    <template id="alternative_products_ribbon_scope" inherit_id="website_sale.alternative_products" name="Alternative Products Ribbon Scope">
        <xpath expr="//section[hasclass('o_wsale_alternative_products')]" position="attributes">
            <attribute name="class" add="oe_website_sale" separator=" "/>
        </xpath>
    </template>
    <template id="website_internal_ref_product" inherit_id="website_sale.product" name="Website Product Internal Ref" active="False">
        <xpath expr="//div[@id='product_details']" position="inside">
            <p t-if="product.product_variant_count == 1 and product.product_variant_id.default_code" class="text-muted small">
                <b><span>Ref. interna: </span></b><span t-out='product.product_variant_id.default_code'/>
            </p>
        </xpath>
    </template>
</odoo>
