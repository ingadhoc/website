<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_internal_ref_products_item" inherit_id="website_sale.products_item" name="Website Products Item Internal Ref" active="False">
        <xpath expr="//div[hasclass('o_wsale_product_sub')]" position="before">
            <p t-if="product.product_variant_id.default_code" class="o_wsale_ux_tile_ref text-muted small">
                <span>Internal Reference: </span><span t-out='product.product_variant_id.default_code'/>
            </p>
        </xpath>
    </template>
    <!-- Anchored on the "t-call", not on the wrapper div: inside it the block would inherit
         core's visibility class. -->
    <template id="products_item_ecommerce_description" inherit_id="website_sale.product_title_and_details" name="Website Products Item eCommerce Description">
        <xpath expr="//div[hasclass('oe_subdescription_wrapper')]/parent::t" position="after">
            <t
                t-call="website_sale.product_tile_element_visibility"
                visible_element_class.f="o_wsale_products_opt_has_ecommerce_description"
            >
                <div class="o_wsale_ecommerce_description_wrapper">
                    <div class="o_wsale_ecommerce_description o_line_clamp text-muted" contenteditable="false">
                        <div t-field="product.description_ecommerce"/>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
    <template id="website_internal_ref_product" inherit_id="website_sale.product" name="Website Product Internal Ref" active="False">
        <xpath expr="//div[@id='product_details']" position="inside">
            <p t-attf-class="o_wsale_ux_internal_ref text-muted small {{'' if combination_info.get('default_code') else 'd-none'}}">
                <b><span>Internal Reference: </span></b><span class="o_wsale_ux_internal_ref_value" t-out="combination_info.get('default_code') or ''"/>
            </p>
        </xpath>
    </template>
</odoo>
