<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale_ux.res_config_settings_view_form_inherit"/>
        <field name="arch" type="xml">
            <field name="cancel_old_quotations" position="after">
                <strong>Website</strong> <field name="cancel_old_website_quotations" style="margin-left:5px;"/>
            </field>
        </field>
    </record>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website.sale.cancel.quotations</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="website_payment_block" position="inside">
                <setting id="cancel_old_quotation_setting" string="Cancel Old Website Quotations"
                         help="Quotations placed through the website are cancelled once they are older than the number of days set in the Sales settings.">
                    <strong>Website</strong> <field name="cancel_old_website_quotations" style="margin-left:5px;"/>
                </setting>
            </block>
        </field>
    </record>
</odoo>
