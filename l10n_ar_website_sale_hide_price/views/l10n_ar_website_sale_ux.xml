<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_tax" name="Product Tax" inherit_id="website_sale.product_price">
        <small t-if="website.company_id.country_code == 'AR'" position="attributes">
            <attribute name='t-if' add="and website.website_show_price" separator=" "/>
        </small>
    </template>

    <template id="products_add_to_cart" inherit_id="l10n_ar_website_sale_ux.products_add_to_cart">
         <small t-if="website.company_id.country_code == 'AR'" position="attributes">
            <attribute name='t-if' add="and website.website_show_price" separator=" "/>
         </small>
    </template>
</odoo>
